    "/api/v1/prices/refresh": {
      "post": {
        "description": "Pull live quotes unless another process did so recently or is doing so now.\n\nThe throttle is shared through Postgres (see app/services/refresh.py), so it\nholds across workers, replicas and the scheduled job.",
        "operationId": "prices-refresh_prices",
        "parameters": [
          {
            "description": "Bypass the routine cooldown. For an explicit user-initiated refresh.",
            "in": "query",
            "name": "force",
            "required": false,
            "schema": {
              "default": false,
              "description": "Bypass the routine cooldown. For an explicit user-initiated refresh.",
              "title": "Force",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Prices-Refresh Prices",
                  "type": "object"
                }
