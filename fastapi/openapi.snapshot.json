    "/api/v1/positions/{asset_id}/history": {
      "get": {
        "description": "The value series behind one position's chart.\n\nMirrors /net-worth: the same three granularities, the same fallback on an\nunknown period, and an empty list rather than a 404 for an asset with no\nsnapshots yet \u2014 the chart renders its own empty state.",
        "operationId": "positions-get_position_history",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "title": "Asset Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "default": "1m",
              "title": "Period",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Positions-Get Position History",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
