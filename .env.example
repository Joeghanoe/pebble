# Settings for docker-compose.prod.yml. Copy to .env and fill in; .env is gitignored.

# Public URL people open, without a trailing slash. Register
# $PEBBLE_URL/oauth2/callback as the redirect URI with your identity provider.
PEBBLE_URL=https://pebble.example.com

# Who may use this instance (comma-separated). The api refuses everyone else.
ALLOWED_EMAILS=you@example.com

POSTGRES_PASSWORD=change-me

# Identity provider. `google`, or `oidc` plus the issuer URL for anything else.
OAUTH2_PROXY_PROVIDER=google
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes, base64: python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# Optional.
COINGECKO_API_KEY=
PRICE_PROVIDERS=coingecko,stooq,yahoo
PROXY_PORT=4180
